# Backend API (NestJS) base URL — note the global prefix /api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Stripe publishable key (test mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Storefront site name (header/footer/SEO)
NEXT_PUBLIC_SITE_NAME=Suuq

# Meta (Facebook) Pixel / Dataset id — powers ad tracking (ViewContent,
# AddToCart, Purchase, …). Public value; safe to commit. Falls back to the
# production id in code if unset.
NEXT_PUBLIC_META_PIXEL_ID=1638279067369914

# OpenReplay session replay. Project key is required to enable it (leave blank
# to disable). INGEST_POINT is only for a self-hosted OpenReplay server; leave
# blank for the openreplay.com cloud.
NEXT_PUBLIC_OPENREPLAY_PROJECT_KEY=
NEXT_PUBLIC_OPENREPLAY_INGEST_POINT=

# WhatsApp support button (digits or +country format both work; unset = button hidden)
NEXT_PUBLIC_WHATSAPP_NUMBER=+905527317410
