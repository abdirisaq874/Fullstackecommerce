# ───────────────────────────────────────────────────────────────────────────
# Smart multilingual search — environment variables
# Copy the relevant lines into your .env (or .env.local).
# Everything is feature-flagged: with no AI keys set, search falls back to
# lexical-only (BM25) so the system still runs end to end.
# ───────────────────────────────────────────────────────────────────────────

# ── OpenSearch ──
OPENSEARCH_NODE=http://localhost:9200
# OPENSEARCH_USERNAME=
# OPENSEARCH_PASSWORD=
SEARCH_PRODUCT_INDEX=products_v1

# ── Locales ──
SEARCH_DEFAULT_LOCALE=en
SEARCH_LOCALES=en,so

# ── Feature flags (1/0) ──
SEARCH_ENABLE_VECTOR=1            # dense kNN retrieval (needs embeddings provider)
SEARCH_ENABLE_RERANK=1           # cross-encoder rerank (needs Cohere key)
SEARCH_ENABLE_QUERY_UNDERSTANDING=1  # Gemini via OpenRouter
SEARCH_ENABLE_TRANSLATION=1      # auto-translate missing locales on index

# ── Embeddings: Cohere embed-multilingual-v3 (default provider) ──
EMBEDDINGS_PROVIDER=cohere       # cohere | openai | none
EMBEDDINGS_DIMS=1024             # cohere embed-multilingual-v3.0 = 1024
COHERE_API_KEY=
COHERE_EMBED_MODEL=embed-multilingual-v3.0
# OpenAI fallback (only if EMBEDDINGS_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Reranker: Cohere Rerank ──
RERANK_PROVIDER=cohere           # cohere | none
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# ── Translation + Query understanding: OpenRouter (Gemini) ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TRANSLATION_MODEL=google/gemini-2.0-flash-001
OPENROUTER_QU_MODEL=google/gemini-2.0-flash-001
