# ─── Application ───
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── MongoDB ───
MONGODB_URI=mongodb://localhost:27017/ecommerce
MONGODB_DB_NAME=ecommerce

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT Auth ───
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Stripe ───
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx
STRIPE_CURRENCY=usd

# ─── Email (SendGrid/SMTP) ───
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASSWORD=your-sendgrid-api-key
MAIL_FROM=noreply@yourshop.com
MAIL_FROM_NAME=YourShop

# ─── File Storage (S3/R2) ───
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://your-bucket.s3.amazonaws.com
STORAGE_ACCESS_KEY=xxxx
STORAGE_SECRET_KEY=xxxx
STORAGE_BUCKET=ecommerce-assets
STORAGE_REGION=us-east-1

# ─── Frontend URL (for CORS & emails) ───
FRONTEND_URL=http://localhost:3001

# ─── Rate Limiting ───
THROTTLE_TTL=60
THROTTLE_LIMIT=100
