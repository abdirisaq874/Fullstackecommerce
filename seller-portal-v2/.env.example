# Backend API base URL consumed by the seller portal client.
# Example: http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Public URL where this Next.js app is served from.
# Used for absolute links, OAuth callbacks, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional: Sentry DSN for client-side error tracking.
# Leave blank to disable Sentry reporting.
NEXT_PUBLIC_SENTRY_DSN=

# Optional: Sentry auth token used at build time to upload source maps.
# Generate at https://sentry.io/orgredirect/organizations/:orgslug/settings/auth-tokens/
# Only needed in CI / production builds; leave blank locally to skip uploads.
SENTRY_AUTH_TOKEN=

# Optional: Stripe publishable key (pk_test_... in dev, pk_live_... in prod).
# Leave blank if Stripe-powered flows are not enabled in this environment.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
