# Caddy ingress for the Suuq Swarm stack.
# Auto-provisions Let's Encrypt TLS for each host and reverse-proxies to the
# Swarm service by name (resolved over the overlay network).
{
	email admin@gaarsiiglobal.com
}

shop.gaarsiiglobal.com {
	reverse_proxy storefront:8080
}

seller.gaarsiiglobal.com {
	reverse_proxy seller-portal:8080
}

api.gaarsiiglobal.com {
	reverse_proxy backend:3000
}

# OpenSearch Dashboards (admin-only). OpenSearch security is disabled, so this
# Caddy basic-auth is the ONLY gate — keep the password strong. User + bcrypt
# hash come from the caddy service env (Secret Manager via deploy.sh).
# Note: `basic_auth` is the Caddy 2.8+ directive name; on older Caddy use `basicauth`.
search.gaarsiiglobal.com {
	basic_auth {
		{$SEARCH_ADMIN_USER:admin} {$SEARCH_ADMIN_HASH}
	}
	reverse_proxy opensearch-dashboards:5601
}
